<Window x:Class="FavExplorer.FavoritesWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FavExplorer"
        Title="Fav Explorer — Favourites"
        Width="1080" Height="720" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <FontFamily x:Key="Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Glyphs}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- The thumbnail, over a photo glyph that shows until it arrives, or for good
             when there is no thumbnail to be had. Missing files are faded out. -->
        <Style x:Key="ThumbBox" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Missing}" Value="True">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Placeholder" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="Text" Value="&#xE91B;" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.35" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasThumb}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Thumb" TargetType="Image">
            <Setter Property="Source" Value="{Binding Thumb}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="DownOnly" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>

        <Style x:Key="MissingTag" TargetType="TextBlock">
            <Setter Property="Text" Value="Missing" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Missing}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ItemsPanelTemplate x:Key="WrapPanel">
            <WrapPanel Margin="8,6" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="StackPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>

        <!-- Extra large, large and medium icons: the box is sized by ThumbBox. -->
        <DataTemplate x:Key="IconTemplate" DataType="{x:Type local:FavItem}">
            <StackPanel Margin="6,6,6,4">
                <Grid Style="{StaticResource ThumbBox}"
                      Width="{Binding ThumbBox, RelativeSource={RelativeSource AncestorType=local:FavoritesWindow}}"
                      Height="{Binding ThumbBox, RelativeSource={RelativeSource AncestorType=local:FavoritesWindow}}">
                    <TextBlock Style="{StaticResource Placeholder}" FontSize="32" />
                    <Image Style="{StaticResource Thumb}" />
                </Grid>
                <TextBlock Text="{Binding Name}" Margin="0,6,0,0" MaxHeight="38"
                           Width="{Binding ThumbBox, RelativeSource={RelativeSource AncestorType=local:FavoritesWindow}}"
                           TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource MissingTag}" HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:FavItem}">
            <Grid Width="330" Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid Style="{StaticResource ThumbBox}" Width="64" Height="64">
                    <TextBlock Style="{StaticResource Placeholder}" FontSize="24" />
                    <Image Style="{StaticResource Thumb}" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Folder}" Style="{StaticResource Secondary}" ToolTip="{Binding Folder}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AddedText}" Style="{StaticResource Secondary}" />
                        <TextBlock Style="{StaticResource MissingTag}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <GridView x:Key="DetailsView">
            <GridViewColumn Header="Name" Width="340">
                <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type local:FavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Style="{StaticResource ThumbBox}" Width="24" Height="24" Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Placeholder}" FontSize="14" />
                                <Image Style="{StaticResource Thumb}" />
                            </Grid>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource MissingTag}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Folder" Width="400" DisplayMemberBinding="{Binding Folder}" />
            <GridViewColumn Header="Favourited" Width="160" DisplayMemberBinding="{Binding AddedText}" />
            <GridViewColumn Header="Size" Width="100">
                <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type local:FavItem}">
                        <TextBlock Text="{Binding SizeText}" TextAlignment="Right" MinWidth="80" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
        </GridView>

        <!-- Icon and tile views draw their own selection, like Explorer's: a soft
             accent fill with a firmer edge, dimmer when the window isn't active. -->
        <Style x:Key="CardItemStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="6" Opacity="0"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Border x:Name="Fill" CornerRadius="6" Opacity="0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Border x:Name="Edge" CornerRadius="6" Opacity="0" BorderThickness="1"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.2" />
                                <Setter TargetName="Edge" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Fill" Property="Opacity" Value="0.12" />
                                <Setter TargetName="Edge" Property="Opacity" Value="0.4" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Details rows. The Fluent theme's own ListViewItem style would otherwise
             win over GridView's and draw each row as the item's type name. -->
        <Style x:Key="RowItemStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="4" Opacity="0"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Border x:Name="Fill" CornerRadius="4" Opacity="0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Border x:Name="Edge" CornerRadius="4" Opacity="0" BorderThickness="1"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                            <GridViewRowPresenter Margin="0,4"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  Content="{TemplateBinding Content}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.2" />
                                <Setter TargetName="Edge" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Fill" Property="Opacity" Value="0.12" />
                                <Setter TargetName="Edge" Property="Opacity" Value="0.4" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Command bar. Narrower than its buttons, it drops their labels, then moves
             the move/copy/share group into the ⋯ menu; see FitCommandBar. -->
        <Grid x:Name="CommandBar" Margin="12,10,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <!-- The search box: as wide as it can be up to 260, pushed to the right. -->
                <ColumnDefinition MinWidth="162" MaxWidth="272" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="BarButtons" Orientation="Horizontal">
                <Button x:Name="OpenButton" Style="{StaticResource BarButton}" Click="OnOpen" ToolTip="Open (Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" />
                        <TextBlock x:Name="OpenLabel" Text="Open" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="RevealButton" Style="{StaticResource BarButton}" Click="OnReveal" ToolTip="Show the file in its folder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" />
                        <TextBlock x:Name="RevealLabel" Text="Show in folder" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="MoveButton" Style="{StaticResource BarButton}" Click="OnMoveTo" ToolTip="Move to another folder or drive">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8DE;" />
                        <TextBlock x:Name="MoveLabel" Text="Move to" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="CopyToButton" Style="{StaticResource BarButton}" Click="OnCopyTo" ToolTip="Copy to another folder or drive">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xF413;" />
                        <TextBlock x:Name="CopyToLabel" Text="Copy to" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>

                <Border x:Name="ActionsDivider" Width="1" Height="20" Margin="8,0" VerticalAlignment="Center"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <!-- Icon-only, as Explorer's own command bar does for these. -->
                <Button x:Name="CopyButton" Style="{StaticResource BarButton}" Click="OnCopy" ToolTip="Copy (Ctrl+C)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
                </Button>
                <Button x:Name="ShareButton" Style="{StaticResource BarButton}" Click="OnShare" ToolTip="Share">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72D;" />
                </Button>
                <Button x:Name="RemoveButton" Style="{StaticResource BarButton}" Click="OnRemove" ToolTip="Remove heart (Delete)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEA92;" />
                </Button>

                <Border Width="1" Height="20" Margin="8,0" VerticalAlignment="Center"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Button Style="{StaticResource BarButton}" Click="OnSortMenu" ToolTip="Sort and group">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8CB;" />
                        <TextBlock x:Name="SortLabel" Text="Sort" Margin="8,0,0,0" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="10" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BarButton}" Click="OnViewMenu" ToolTip="Change the view (Ctrl+mouse wheel)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A9;" />
                        <TextBlock x:Name="ViewLabel" Text="View" Margin="8,0,0,0" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="10" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BarButton}" Click="OnMoreMenu" ToolTip="More">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE712;" />
                </Button>
            </StackPanel>

            <Grid Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" Padding="34,6,10,6" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="13" Margin="12,0,0,0"
                           IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="SearchHint" Text="Search favourites" Margin="35,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Grid>

        <!-- The favourites themselves -->
        <Border Grid.Row="1" Margin="12,0" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <ListView x:Name="Favs"
                          Background="Transparent" BorderThickness="0"
                          SelectionMode="Extended"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          PreviewMouseLeftButtonDown="OnListMouseDown"
                          PreviewMouseMove="OnListMouseMove"
                          PreviewMouseLeftButtonUp="OnListMouseUp"
                          PreviewMouseWheel="OnListWheel">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="14,16,14,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ItemCount, StringFormat='({0})'}" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Height="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>

                <TextBlock x:Name="EmptyText" Visibility="Collapsed" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- Status bar, with Explorer's two quick view switches on the right -->
        <Grid Grid.Row="2" Margin="18,6,12,8">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DetailsButton" Style="{StaticResource BarButton}" Padding="8,4"
                        Click="OnDetailsButton" ToolTip="Details (Ctrl+Shift+6)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="13" />
                </Button>
                <Button x:Name="IconsButton" Style="{StaticResource BarButton}" Padding="8,4"
                        Click="OnIconsButton" ToolTip="Large icons (Ctrl+Shift+2)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xF0E2;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
