<Window x:Class="FavExplorer.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FavExplorer"
        Title="Fav Explorer — Settings"
        Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <FontFamily x:Key="Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- One card per section, the way Windows 11 Settings groups things. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- A key as a keycap. -->
        <DataTemplate x:Key="KeyCap">
            <Border Margin="0,0,6,0" Padding="10,3" CornerRadius="4" BorderThickness="1,1,1,2"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <TextBlock Text="{Binding}" FontWeight="SemiBold" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HandlerRow" DataType="{x:Type local:HandlerRow}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Rank" Text="{Binding Rank}" TextAlignment="Right" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="HandlerName" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Border x:Name="OursTag" Visibility="Collapsed" Padding="8,0" CornerRadius="9"
                            Background="#22E81123">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB52;" FontFamily="{StaticResource Glyphs}" FontSize="10"
                                       Foreground="#E81123" VerticalAlignment="Center" />
                            <TextBlock Text="Fav Explorer" FontSize="11" Margin="5,1,0,1" Foreground="#C50F1F" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="Ignored" Text="ignored by Windows" FontSize="11" Visibility="Collapsed"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Ours}" Value="True">
                    <Setter TargetName="OursTag" Property="Visibility" Value="Visible" />
                    <Setter TargetName="HandlerName" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Honoured}" Value="False">
                    <Setter TargetName="Ignored" Property="Visibility" Value="Visible" />
                    <Setter TargetName="HandlerName" Property="Opacity" Value="0.5" />
                    <Setter TargetName="Rank" Property="Opacity" Value="0.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,16,20,20">

        <!-- About, and the opt-in update check -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Image x:Name="AboutIcon" Width="40" Height="40" Margin="0,2,16,0" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Fav Explorer" Style="{StaticResource CardTitle}" Margin="0" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,0" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="UpdatesBox" Content="Check for updates once a week" VerticalAlignment="Center" />
                        <Button x:Name="CheckNowButton" Grid.Column="1" Content="Check now" Margin="12,0,0,0" Padding="16,6"
                                VerticalAlignment="Center" Click="OnCheckNow" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Asks GitHub which version is the latest, and tells you in the notification area when there's a newer one. Nothing about you or your files is sent." />
                    <TextBlock x:Name="UpdateStatus" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                               Text="Free and open source under the MIT licence. Apart from that update check, Fav Explorer never goes online, and nothing about your files leaves your PC." />
                    <TextBlock Margin="0,10,0,0">
                        <Hyperlink NavigateUri="https://github.com/tashreefshareef/fav-explorer" RequestNavigate="OnLink">GitHub page</Hyperlink>
                        <Run Text="   ·   " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Hyperlink NavigateUri="https://github.com/tashreefshareef/fav-explorer/releases" RequestNavigate="OnLink">All releases</Hyperlink>
                        <Run Text="   ·   " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Hyperlink NavigateUri="https://github.com/tashreefshareef/fav-explorer/issues/new" RequestNavigate="OnLink">Report a problem</Hyperlink>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="© 2026 MOHAMMED Tashreef" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Shortcut -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Shortcut" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource Caption}"
                           Text="Click the box and press the combination you want. It only fires while File Explorer or the Photos viewer is in front." />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="Capture" Focusable="True" Cursor="Hand" MinHeight="40" Padding="10,6"
                            CornerRadius="6" BorderThickness="1"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            MouseLeftButtonDown="OnCaptureClick"
                            GotKeyboardFocus="OnCaptureFocus" LostKeyboardFocus="OnCaptureBlur"
                            PreviewKeyDown="OnCaptureKey"
                            ToolTip="Click, then press the new shortcut">
                        <Grid VerticalAlignment="Center">
                            <ItemsControl x:Name="KeyCaps" ItemTemplate="{StaticResource KeyCap}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="CaptureHint" Text="Press a combination…" Visibility="Collapsed"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Content="Default" Margin="12,0,0,0" Padding="16,6"
                            VerticalAlignment="Center" Click="OnDefaultShortcut" />
                </Grid>

                <TextBlock x:Name="CaptureError" Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </Border>

        <!-- Behaviour -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Behaviour" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                <CheckBox x:Name="ToastBox" Content="Show a confirmation after the shortcut fires" />
                <CheckBox x:Name="StartupBox" Content="Start Fav Explorer when I sign in" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                           Text="Hearts keep showing even when Fav Explorer is closed. What needs it running is changing them, and keeping the folder index below in step." />
            </StackPanel>
        </Border>

        <!-- Diagnosis -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Is the heart actually being drawn?" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SlotGlyph" FontFamily="{StaticResource Glyphs}" FontSize="16" Margin="0,2,10,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="SlotHeadline" FontWeight="SemiBold" />
                        <TextBlock x:Name="SlotDetail" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="IndexGlyph" FontFamily="{StaticResource Glyphs}" FontSize="16" Margin="0,2,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="IndexHeadline" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="IndexDetail" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Repair" Margin="12,0,0,0" Padding="16,6"
                            VerticalAlignment="Center" Click="OnRepair"
                            ToolTip="Republish the folder index from the favourites list" />
                </Grid>

                <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,8"
                           Text="Windows keeps one list of icon overlay handlers for every app and only honours the first few. The ones Fav Explorer is competing with:" />
                <Border CornerRadius="6" BorderThickness="1" Padding="8,6"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource LayerFillColorDefaultBrush}">
                    <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Handlers" ItemTemplate="{StaticResource HandlerRow}" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" MinWidth="96" Padding="16,6" Click="OnSave"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
            <Button Content="Cancel" IsCancel="True" MinWidth="96" Padding="16,6" Margin="8,0,0,0" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
