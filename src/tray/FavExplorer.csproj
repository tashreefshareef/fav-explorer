<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The favourites window is WPF for its Fluent theme; the tray and Settings
         stay WinForms. ThemeMode is still flagged experimental (WPF0001). -->
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Explorer is 64-bit, and so is the overlay DLL. Staying x64 keeps the
         registry views and the memory-mapped index consistent across both. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <AssemblyName>FavExplorer</AssemblyName>
    <RootNamespace>FavExplorer</RootNamespace>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Product>Fav Explorer</Product>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Reading the Explorer selection goes through IDispatch on Shell.Application,
         which needs the built-in COM marshalling that trimming would strip. -->
    <PublishTrimmed>false</PublishTrimmed>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF takes System.IO out of the implicit usings (it clashes with
         System.Windows.Shapes.Path); the WinForms half relies on it. -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
